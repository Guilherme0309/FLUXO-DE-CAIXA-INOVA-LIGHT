<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Minha base Express + SQLite</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/script.js" defer></script>
</head>
<body>

  <%- include('partials/header') %>

  <main class="container">
    <h1>NOVA MOVIMENTAÇÃO %></h1>

    
<form
    action="/novaMovimentacao"
    method="POST"
    class="formulario"
    id="formLancamento"
    style="width: 100%;"
>
    <div>
        <label for="tipo_mov">Tipo de Movimentação:</label>
        <select id="tipo_mov" name="tipo_mov" required>
            <option value="" disabled selected>Selecione o tipo</option>
            <option value="ENT">Entrada</option>
            <option value="SAI">Saída</option>
        </select>
    </div>

    <div>
        <label for="data">Data da Movimentação:</label>
        <input type="date" id="data" name="data" value="<%= dataAtual %>" max="<%= dataAtual %>" required>
    </div>

    <div>
        <label for="descricao">Descrição da Movimentação:</label>
        <textarea
        id="descricao"
        name="descricao"
        placeholder="Descreva a movimentação"
        maxlength="200"
        rows="3"
        required
    ></textarea>
    </div>

    <div>
        <label for="valor">Valor da Movimentação:</label>
        <input
            type="text"
            id="valor"
            placeholder="R$ 0,00"
            inputmode="numeric"
            required
        >
        <input type="hidden" id="valorDecimal" name="valor">
    </div>

    <button type="submit">Adicionar Movimentação</button>
</form>


  </main>

</body>
</html>
