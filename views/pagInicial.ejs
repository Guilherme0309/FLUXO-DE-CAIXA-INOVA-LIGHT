
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Movimentações - Inova Light</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<%- include('partials/header') %>

<main class="container">

<form action="/" method="GET">

    <label for="ano" style="font-size: 25px;">DASHBOARD FINANCEIRO  </label>

    <select
        id="ano"
        name="ano"
        onchange="this.form.submit()"
    >
        <% for (let i = 2024; i <= 2035; i++) { %>
            <option
                value="<%= i %>"
                <%= Number(anoAtual) === i ? 'selected' : '' %>
            >
                <%= i %>
            </option>
        <% } %>
    </select>

</form>

    <!-- CASO NÃO EXISTAM MOVIMENTAÇÕES -->
    <% if (totais.length === 0) { %>

        <h1>Nenhuma movimentação cadastrada neste mês.</h1>

    <% } else { %>
    

    <h1>Total Anual</h1>

                
    <div class="resumo-financeiro">

    <div class="caixa-financeira">
        <h3>Total de Entradas</h3>

        <label id="Entradas">
            R$ <%= totais.ENTRADAS.toLocaleString('pt-BR', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            }) %>
        </label>
    </div>

    <div class="caixa-financeira">
        <h3>Total de Saídas</h3>

        <label id="Saidas">
            R$ <%= totais.SAIDAS.toLocaleString('pt-BR', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            }) %>
        </label>
    </div>

    <div class="caixa-financeira">
        <h3>Saldo Total</h3>

        <label id="Total">
            R$ <%= totais.SALDO.toLocaleString('pt-BR', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            }) %>
        </label>
    </div>

    </div>
        <h1>Fluxo de Caixa Mensal <%= anoAtual %></h1>  

        <table>
            <thead>
                <tr>
                    <th>MÊS</th>
                    <th>ENTRADAS</th>
                    <th>SAÍDAS</th>
                    <th>SALDOS</th>
                    <th>ACESSAR</th>
                </tr>
            </thead>

            <tbody>
                <% for (let i = 0; i < 12; i++) { %>

                    <% 
                        const mesNumero = String(i + 1).padStart(2, '0');
                        const periodo = anoAtual + '-' + mesNumero;

                        const dadosMes = totalMeses.find(
                            item => item.MES === periodo
                        );
                    %>

                    <tr>
                        <td><%= meses[i] %></td>

                        <td>
                            R$ <%= (dadosMes ? dadosMes.ENTRADAS : 0)
                                .toLocaleString('pt-BR', {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                }) %>
                        </td>

                        <td>
                            R$ <%= (dadosMes ? dadosMes.SAIDAS : 0)
                                .toLocaleString('pt-BR', {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                }) %>
                        </td>

                        <td>
                            R$ <%= (dadosMes ? dadosMes.SALDO : 0)
                                .toLocaleString('pt-BR', {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                }) %>
                        </td>
                        <td>
                            <a href="/TabMovimentacoes?mes=<%= anoAtual + '-' + mesNumero;%>&tipo_mov=%25">LINK</a>
                        </td>
                    </tr>

                <% } %>
            </tbody>

        <tfoot>
            </tfoot>
        </table>

    <% } %>

</main>

</body>
</html>
