
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Movimentações - Inova Light</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <%- include('partials/header') %>


<a href="/<%if (mes != '%'){ %>?ano=<%=mes.slice(0, 4)%><% } %>" class="btn-voltar" title="Voltar ao Dashboard">
    &#8592; Voltar
</a>

<main class="container">


<h1>
    TABELA DE MOVIMENTAÇÕES

    <% if (mes && mes !== '%') { %>

        <%= new Date(mes + '-01T12:00:00').toLocaleDateString('pt-BR', {
            month: 'long',
            year: 'numeric'
        }).toUpperCase() %>

    <% } else { %>

        GERAL

    <% } %>
</h1>

    
<form action="/TabMovimentacoes" method="GET">

    <!-- Mantém o mês escolhido no Dashboard -->
    <input type="hidden" name="mes" value="<%= mes %>">

    <label for="tipo_mov">Tipo de Movimentação:</label>

    <select
        id="tipo_mov"
        name="tipo_mov"
        onchange="this.form.submit()"
    >
        <option value="%"
            <%= tipo_mov === '%' ? 'selected' : '' %>>
            Todas
        </option>

        <option value="ENT"
            <%= tipo_mov === 'ENT' ? 'selected' : '' %>>
            Entradas
        </option>

        <option value="SAI"
            <%= tipo_mov === 'SAI' ? 'selected' : '' %>>
            Saídas
        </option>
    </select>

</form>


    <hr>

    <!-- CASO NÃO EXISTAM MOVIMENTAÇÕES -->
    <% if (dados.length === 0) { %>

        <h1>Nenhuma movimentação cadastrada</h1>

    <% } else { %>
    
<div class="resumo-financeiro">

    <% if (tipo_mov === '%' || tipo_mov === 'ENT') { %>
        <div class="caixa-financeira">
        <h3>Total de Entradas</h3>

        <label id="Entradas">
            R$ <%= totalMes.ENTRADAS.toLocaleString('pt-BR', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            }) %>
        </label>
        </div>
    <% } %>
    <% if (tipo_mov === '%' || tipo_mov === 'SAI') { %>
    <div class="caixa-financeira">
        <h3>Total de Saídas</h3>

        <label id="Saidas">
            R$ <%= totalMes.SAIDAS.toLocaleString('pt-BR', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            }) %>
        </label>
    </div> 
    <% } %>
    <% if (tipo_mov === '%') { %>
    <div class="caixa-financeira">
        <h3>Saldo Total</h3>

        <label id="Total">
            R$ <%= totalMes.SALDO.toLocaleString('pt-BR', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            }) %>
        </label>
    </div>
    <% } %>
</div>

    <!-- TABELA DE MOVIMENTAÇÕES -->
    <table>
        <thead>
            <tr>
                <th>DATA</th>
                <th>DESCRIÇÃO</th>
                <th>TIPO</th>
                <th>VALOR</th>
                <th>EDITAR</th>
            </tr>
        </thead>

        <tbody>

            <% let qtd_posts = pag * 8 %>

            <!-- LISTAGEM DE 5 EM 5 MOVIMENTAÇÕES -->
            <% let i = qtd_posts - 8;
               for (i = qtd_posts - 8; i < qtd_posts; i++) { %>

                <% if (i < dados.length) { %>

                    <tr>

                        <td>
                            <%= dados[i].DATA.split('-').reverse().join('/') %>
                        </td>

                        <td>
                            <%= dados[i].DESCRICAO %>
                        </td>

                        <td>
                            <% if (dados[i].TIPO_MOV == 'ENT') { %>
                                Entrada
                            <% } else if (dados[i].TIPO_MOV == 'SAI') { %>
                                Saída
                            <% } %>
                        </td>

                        <td>
                            R$ <%= Number(dados[i].VALOR)
                                .toLocaleString('pt-BR', {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                }) %>
                        </td>
                        <td>
                            <a href="/editMovimentacao?id=<%= Number(dados[i].ID)%>">EDITAR</a>
                        </td>

                    </tr>

                <% } %>

            <% } %>

        </tbody>

       
<tfoot>
    <tr>

        <!-- PÁGINA ANTERIOR -->
        <td colspan="1" style="text-align: left;">

            <% if (pag > 1) { %>

                <a href="/TabMovimentacoes?mes=<%= mes %>&tipo_mov=<%= tipo_mov %>&pag=<%= Number(pag) - 1 %>">
                    ⬅
                </a>

            <% } %>

        </td>

        <!-- NÚMERO DA PÁGINA -->
        <td colspan="3" style="text-align: center;">

            <% if (totalPaginas > 1) { %>
                <%= pag %> / <%= totalPaginas %>
            <% } %>

        </td>

        <!-- PRÓXIMA PÁGINA -->
        <td colspan="1" style="text-align: right;">

            <% if (pag < totalPaginas) { %>

                <a href="/TabMovimentacoes?mes=<%= mes %>&tipo_mov=<%= tipo_mov %>&pag=<%= Number(pag) + 1 %>">
                    ⮕
                </a>

            <% } %>

        </td>

    </tr>
</tfoot>


    </table>
    <% } %>
    

</main>

</body>
</html>
